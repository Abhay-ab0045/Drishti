{
  "manifest_version": 3,
  "name": "Drishti \u2014 Privacy Vision Agent (Firefox)",
  "version": "0.2.0",
  "description": "Privacy-preserving browser vision agent. Detects and redacts sensitive data on-device before any network transmission.",
  "browser_specific_settings": {
    "gecko": {
      "id": "drishti@drishti.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.vercel.app/*"
  ],
  "background": {
    "scripts": ["src/background/background.ts"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://localhost/*", "*://127.0.0.1/*", "https://*.vercel.app/*"],
      "js": ["src/content-scripts/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": [
        "wasm/*",
        "mediapipe/*",
        "models/*",
        "test-assets/*"
      ]
    }
  ]
}
